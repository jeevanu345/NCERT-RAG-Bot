      "textbook list",
      "flashcard review"
    ]
  },
  "constraints": {
    "must": [
      "Simple and intuitive study interface",
      "NVIDIA NIM BYOK",
      "Visible focus and mobile navigation",
      "No local model dependency"
    ],
    "avoid": [
      "Decorative gradients",
      "External runtime fonts",
      "Fake upload success",
      "Persisting keys to the library database"
    ]
  },
  "decisions": [
    {
      "decision": "White study canvas, sage navigation, forest-green actions, restrained serif headings.",
      "source": "User-requested simple aesthetic redesign"
    },
    {
      "decision": "Reuse installed controls and Radix dialogs; custom layout grounded in light sidebar and conversation-list catalog search.",
      "source": "21st search plus existing components"
    }
  ],
  "evidence": [
    {
      "fact": "All palette tokens come from the implemented CSS",
      "source": "src/app/globals.css"
    },
    {
      "fact": "No source-upload review was run; local browser and accessibility checks used instead after automatic review rejected the hosted review command.",
      "source": "Local verification"
    }
