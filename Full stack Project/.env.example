# Optional: use Settings in the browser for BYOK instead.
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
# Python backend (keep bound to localhost for local use).
PYTHON_API_BASE_URL=http://127.0.0.1:8000
# Optional persistent SQLite directory, default: Full stack Project/.data
# NCERT_DATA_DIR=/absolute/path/to/private/data

# Optional OAuth. Generate a stable secret with: npm run auth:secret (repo root).
# Keep secrets in .env.local, never NEXT_PUBLIC_ variables.
AUTH_SECRET=
# Must match the address used in the browser and registered callback URLs.
AUTH_URL=http://127.0.0.1:3000
# true requires authentication for the workspace and its API; false allows guests.
AUTH_REQUIRED=false

AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/common/v2.0
AUTH_APPLE_ID=
# ES256 client-secret JWT, generated with npm run auth:apple-secret. Not the .p8 key.
AUTH_APPLE_SECRET=
# Provider consoles and exact callbacks: ../docs/OAUTH_SETUP.md
